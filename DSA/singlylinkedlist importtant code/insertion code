# Full Code — Singly Linked List Insertion

```cpp
#include <iostream>
using namespace std;

class Node
{
public:
    int value;
    Node *next;

    Node(int value)
    {
        this->value = value;
        this->next = NULL;
    }
};

class SinglyLinkedList
{
private:
    Node *head;

public:

    SinglyLinkedList()
    {
        this->head = NULL;
    }

    // 1. INSERTION AT FIRST
    void insertAtFirst(int data)
    {
        Node *temp = new Node(data);

        // Case 1 and Case 2
        temp->next = head;
        head = temp;
    }

    // 2. INSERTION AT LAST
    void insertAtLast(int data)
    {
        Node *newNode = new Node(data);

        // Case 1: No node
        if (head == NULL)
        {
            head = newNode;
            return;
        }

        // Case 2: n nodes
        Node *temp = head;

        while (temp->next != NULL)
        {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    // 3. INSERTION IN BETWEEN
    void insertInBetween(int data, int targetedValue)
    {
        // Case 1: No node
        if (head == NULL)
        {
            cout << "Nodes are not there" << endl;
            return;
        }

        Node *temp = head;

        // Find target
        while (temp != NULL &&
               temp->value != targetedValue)
        {
            temp = temp->next;
        }

        // Case 2: Target not found
        if (temp == NULL)
        {
            cout << "Targeted node doesn't exist" << endl;
            return;
        }

        // Case 3: Target found
        Node *newNode = new Node(data);

        newNode->next = temp->next;
        temp->next = newNode;
    }

    // DISPLAY
    void display()
    {
        if (head == NULL)
        {
            cout << "No nodes exist" << endl;
            return;
        }

        Node *temp = head;

        while (temp != NULL)
        {
            cout << temp->value << " ";
            temp = temp->next;
        }

        cout << endl;
    }
};

int main()
{
    SinglyLinkedList obj;

    obj.insertAtFirst(10);
    obj.insertAtFirst(20);

    obj.insertAtLast(30);

    obj.insertInBetween(25, 20);

    obj.display();

    return 0;
}
```

