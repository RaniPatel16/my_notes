#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;

    Node(int value) {
        data = value;
        next = NULL;
    }
};


// 1. Insert at Beginning
void insertAtBeginning(Node*& head, int value) {

    Node* newNode = new Node(value);

    newNode->next = head;
    head = newNode;
}


// 2. Insert at Last
void insertAtLast(Node*& head, int value) {

    Node* newNode = new Node(value);

    if (head == NULL) {
        head = newNode;
        return;
    }

    Node* temp = head;

    while (temp->next != NULL) {
        temp = temp->next;
    }

    temp->next = newNode;
}


// 3. Insert After Target Value
void insertAfter(Node* head, int targetValue, int newNodeData) {

    Node* temp = head;

    while (temp != NULL && temp->data != targetValue) {
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Target value not found" << endl;
        return;
    }

    Node* newNode = new Node(newNodeData);

    newNode->next = temp->next;
    temp->next = newNode;
}


// 4. Insert Before Target Value
void insertBefore(Node*& head, int targetValue, int newNodeData) {

    if (head == NULL) {
        cout << "List is empty" << endl;
        return;
    }

    Node* newNode = new Node(newNodeData);

    // If target is first node
    if (head->data == targetValue) {
        newNode->next = head;
        head = newNode;
        return;
    }

    Node* temp = head;

    while (temp->next != NULL &&
           temp->next->data != targetValue) {
        temp = temp->next;
    }

    if (temp->next == NULL) {
        cout << "Target value not found" << endl;
        delete newNode;
        return;
    }

    newNode->next = temp->next;
    temp->next = newNode;
}


// 5. Insert At Position
void insertAtPosition(Node*& head, int position, int newNodeData) {

    Node* newNode = new Node(newNodeData);

    // Position 1 means beginning
    if (position == 1) {
        newNode->next = head;
        head = newNode;
        return;
    }

    Node* temp = head;

    // Go to node before required position
    for (int i = 1; i < position - 1; i++) {

        if (temp == NULL) {
            cout << "Invalid position" << endl;
            delete newNode;
            return;
        }

        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Invalid position" << endl;
        delete newNode;
        return;
    }

    newNode->next = temp->next;
    temp->next = newNode;
}


// Display Linked List
void display(Node* head) {

    Node* temp = head;

    while (temp != NULL) {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL" << endl;
}


int main() {

    Node* head = NULL;

    // Create original linked list
    insertAtLast(head, 10);
    insertAtLast(head, 32);
    insertAtLast(head, 47);
    insertAtLast(head, 18);
    insertAtLast(head, 59);

    cout << "Original List:" << endl;
    display(head);


    // 1. Insert at Beginning
    insertAtBeginning(head, 5);

    cout << "\nAfter Insert at Beginning:" << endl;
    display(head);


    // 2. Insert at Last
    insertAtLast(head, 100);

    cout << "\nAfter Insert at Last:" << endl;
    display(head);


    // 3. Insert 64 after 18
    insertAfter(head, 18, 64);

    cout << "\nAfter Insert 64 After 18:" << endl;
    display(head);


    // 4. Insert 50 before 47
    insertBefore(head, 47, 50);

    cout << "\nAfter Insert 50 Before 47:" << endl;
    display(head);


    // 5. Insert 25 at Position 3
    insertAtPosition(head, 3, 25);

    cout << "\nAfter Insert 25 At Position 3:" << endl;
    display(head);


    return 0;
}