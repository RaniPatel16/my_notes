DESC Student;
 
 
SELECT Department, COUNT(*) AS Total_Students
FROM Student
GROUP BY Department;

-- display avrage markes of the stufent
SELECT AVG(Marks) AS Average_Marks
FROM Student;

-- display highest markes of student 
SELECT MAX(Marks) 
FROM Student;
-- display min marks of each department 
SELECT Department, MIN(Marks) 
FROM Student
GROUP BY Department;

-- display student detailes in whitch department having morv then 2 marks 
SELECT Department, COUNT(*) 
FROM Student
GROUP BY Department
HAVING COUNT(*) = 2;

-- diisplay dipartment whose average markes is greterthen 80 
SELECT Department, AVG(Marks) 
FROM Student
GROUP BY Department
HAVING AVG(Marks) > 80;
-- display the total markes scored by each department 
SELECT Department, SUM(Marks) 
FROM Student
GROUP BY Department;