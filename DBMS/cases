-- Display Final Result
SELECT
    Product_ID,
    Product_Name,
    Category,
    Supplier,
    Stock_Quantity,
    Price,
    CASE
        WHEN Stock_Quantity = 0 THEN 'Out of Stock'
        WHEN Stock_Quantity <= 10 THEN 'Low Stock'
        ELSE 'In Stock'
    END AS Stock_Status
FROM Products;