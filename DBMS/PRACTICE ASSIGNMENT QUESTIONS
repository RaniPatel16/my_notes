-- Display all departments.
SELECT * FROM Departments;
-- Display all students.
SELECT * FROM Students;
-- Display all courses.
SELECT * FROM Courses;
-- Show only student names.
SELECT student_name FROM Students;

-- Show distinct cities.
SELECT city FROM Students; 

-- Students with marks > 80.
SELECT marks from Students where marks>80; 

-- Students from Ahmedabad.
SELECT * from  students where city="Ahmedabad";

-- Female students.
SELECT gender from Students where gender="Female";

-- Sort students by marks descending.
SELECT * from Students ORDER BY marks DESC;

-- Show top 5 students by marks.
SELECT * FROM Students LIMIT 5;



-- Aggregation
-- Count students.
SELECT COUNT(*) FROM Students;

-- Average marks.
SELECT AVG(marks) from Students;
-- Highest marks.
SELECT MAX(marks) FROM Students;
-- Lowest marks.
SELECT MIN(marks) from Students;
-- Total marks.
SELECT SUM(marks) from Students;

-- ORDER BY Practice
-- Display students sorted by marks ascending.
